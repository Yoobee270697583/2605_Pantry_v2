DB_NAME=pantry
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY='change-me'
DEBUG=True

# Claude API key for the AI swap tips on Suggested Recipes - make one at https://platform.claude.com
# optional - if it's empty everything else still works, the AI tips just say they aren't available
ANTHROPIC_API_KEY=

# USDA FoodData Central key - get a free one at https://api.data.gov/signup/
# DEMO_KEY works too, it's just limited to 30 requests an hour
USDA_API_KEY=DEMO_KEY

# Hosting - optional locally, these defaults are fine for runserver
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
USE_HTTPS=False

# AWS only - set these as Elastic Beanstalk environment properties, not in your .env
# RUN_IMPORTS=false
# DJANGO_SUPERUSER_USERNAME=change-me
# DJANGO_SUPERUSER_EMAIL=change-me@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me