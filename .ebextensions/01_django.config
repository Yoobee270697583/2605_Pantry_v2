# Elastic Beanstalk runs this on every deploy (Amazon Linux 2023, Python platform).
# container_commands run after the new code is unpacked, before the app is switched over.

container_commands:
  # create/update the database tables - only on one instance (leader_only)
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
    leader_only: true

  # copy every static file (css, images, admin) into staticfiles/ for nginx to serve
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py collectstatic --noinput"

  # OPTIONAL one-off data load (same order as the README): set the environment
  # property RUN_IMPORTS=true, deploy once, then set it back to false
  # (otherwise every deploy re-imports)
  03_imports:
    command: "if [ \"$RUN_IMPORTS\" = \"true\" ]; then source /var/app/venv/*/bin/activate && python3 manage.py import_ingredients && python3 manage.py merge_ingredients && python3 manage.py import_usda_portions && python3 manage.py import_recipes; fi"
    leader_only: true

  # OPTIONAL admin account: set DJANGO_SUPERUSER_USERNAME, DJANGO_SUPERUSER_EMAIL and
  # DJANGO_SUPERUSER_PASSWORD as environment properties. "|| true" so later deploys
  # don't fail once the user already exists
  04_superuser:
    command: "if [ -n \"$DJANGO_SUPERUSER_USERNAME\" ]; then source /var/app/venv/*/bin/activate && python3 manage.py createsuperuser --noinput || true; fi"
    leader_only: true

option_settings:
  # nginx serves /static/ straight from the staticfiles folder made by collectstatic
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles
